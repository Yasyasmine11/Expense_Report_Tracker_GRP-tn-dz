<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ExpenseTrackerApp.Pages.CreateExpensePage"
             Title="New Expense"
             BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="Create Expense Report"
                   FontSize="22" FontAttributes="Bold" TextColor="#1A1A2E"/>

            <!-- Amount -->
            <Frame BackgroundColor="White" CornerRadius="12" Padding="16" BorderColor="Transparent">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Amount (€)" FontAttributes="Bold" TextColor="#444"/>
                    <Entry x:Name="AmountEntry"
                           Placeholder="0.00"
                           Keyboard="Numeric"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#FF9900"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Category -->
            <Frame BackgroundColor="White" CornerRadius="12" Padding="16" BorderColor="Transparent">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Category" FontAttributes="Bold" TextColor="#444"/>
                    <Picker x:Name="CategoryPicker" Title="Select a category">
                        <Picker.Items>
                            <x:String>TRAVEL</x:String>
                            <x:String>MEAL</x:String>
                            <x:String>EQUIPMENT</x:String>
                            <x:String>OTHER</x:String>
                        </Picker.Items>
                    </Picker>
                </VerticalStackLayout>
            </Frame>

            <!-- Description -->
            <Frame BackgroundColor="White" CornerRadius="12" Padding="16" BorderColor="Transparent">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Description" FontAttributes="Bold" TextColor="#444"/>
                    <Editor x:Name="DescriptionEditor"
                            Placeholder="e.g. Client lunch at Le Marais"
                            HeightRequest="100"
                            BackgroundColor="Transparent"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Error -->
            <Label x:Name="ErrorLabel" TextColor="Red" IsVisible="False" HorizontalOptions="Center"/>

            <!-- Buttons -->
            <Button Text="Save as Draft"
                    Clicked="OnSaveDraftClicked"
                    BackgroundColor="#FF9900"
                    TextColor="White"
                    CornerRadius="12"
                    HeightRequest="50"
                    FontAttributes="Bold"/>

            <Button Text="Cancel"
                    Clicked="OnCancelClicked"
                    BackgroundColor="Transparent"
                    TextColor="Gray"
                    BorderColor="LightGray"
                    BorderWidth="1"
                    CornerRadius="12"
                    HeightRequest="44"/>

            <ActivityIndicator x:Name="Loader" IsVisible="False" IsRunning="False"
                               Color="#FF9900" HorizontalOptions="Center"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
