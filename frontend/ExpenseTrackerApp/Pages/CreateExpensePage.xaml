<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ExpenseTrackerApp.Pages.CreateExpensePage"
             Title="Nouvelle note de frais"
             BackgroundColor="#F0F2F5">

    <ScrollView>
        <VerticalStackLayout Padding="20,16" Spacing="14">

            <Label Text="📝 Nouvelle note de frais"
                   FontSize="20" FontAttributes="Bold"
                   TextColor="#1A202C"/>

            <!-- Montant -->
            <Border BackgroundColor="White" StrokeShape="RoundRectangle 12"
                    Stroke="#E2E8F0" Padding="16,14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Montant (€)" FontAttributes="Bold" FontSize="13" TextColor="#4A5568"/>
                    <Border BackgroundColor="#F7FAFC" StrokeShape="RoundRectangle 8"
                            Stroke="#CBD5E0" Padding="12,0">
                        <Entry x:Name="AmountEntry"
                               Placeholder="0.00"
                               PlaceholderColor="#A0AEC0"
                               Keyboard="Numeric"
                               FontSize="28" FontAttributes="Bold"
                               TextColor="#FF9900"
                               HeightRequest="52"
                               BackgroundColor="Transparent"/>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Catégorie -->
            <Border BackgroundColor="White" StrokeShape="RoundRectangle 12"
                    Stroke="#E2E8F0" Padding="16,14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Catégorie" FontAttributes="Bold" FontSize="13" TextColor="#4A5568"/>
                    <Border BackgroundColor="#F7FAFC" StrokeShape="RoundRectangle 8"
                            Stroke="#CBD5E0" Padding="12,4">
                        <Picker x:Name="CategoryPicker"
                                Title="Sélectionner une catégorie"
                                TitleColor="#A0AEC0"
                                TextColor="#1A202C"
                                BackgroundColor="Transparent">
                            <Picker.Items>
                                <x:String>TRANSPORT</x:String>
                                <x:String>REPAS</x:String>
                                <x:String>HÉBERGEMENT</x:String>
                                <x:String>MATÉRIEL</x:String>
                                <x:String>AUTRE</x:String>
                            </Picker.Items>
                        </Picker>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Description -->
            <Border BackgroundColor="White" StrokeShape="RoundRectangle 12"
                    Stroke="#E2E8F0" Padding="16,14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Description" FontAttributes="Bold" FontSize="13" TextColor="#4A5568"/>
                    <Border BackgroundColor="#F7FAFC" StrokeShape="RoundRectangle 8"
                            Stroke="#CBD5E0" Padding="12,8">
                        <Editor x:Name="DescriptionEditor"
                                Placeholder="Ex : Déjeuner client, billet de train Paris-Lyon..."
                                PlaceholderColor="#A0AEC0"
                                TextColor="#1A202C"
                                HeightRequest="100"
                                BackgroundColor="Transparent"/>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Reçu -->
            <Border BackgroundColor="White" StrokeShape="RoundRectangle 12"
                    Stroke="#E2E8F0" Padding="16,14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Reçu (optionnel)" FontAttributes="Bold" FontSize="13" TextColor="#4A5568"/>
                    <Button x:Name="PickFileBtn"
                            Text="📎 Choisir une photo"
                            Clicked="OnPickFileClicked"
                            BackgroundColor="#EBF4FF"
                            TextColor="#3182CE"
                            BorderColor="#BEE3F8"
                            BorderWidth="1.5"
                            CornerRadius="8"
                            HeightRequest="44"
                            FontSize="13"/>
                    <Label x:Name="FileNameLabel"
                           Text="Aucun fichier sélectionné"
                           TextColor="#A0AEC0"
                           FontSize="12"/>
                </VerticalStackLayout>
            </Border>

            <!-- Erreur -->
            <Border x:Name="ErrorBox"
                    BackgroundColor="#FFF5F5"
                    StrokeShape="RoundRectangle 8"
                    Stroke="#FC8181"
                    Padding="14,10"
                    IsVisible="False">
                <Label x:Name="ErrorLabel" TextColor="#C53030" FontSize="13"/>
            </Border>

            <!-- Indicateur -->
            <ActivityIndicator x:Name="Loader"
                               IsVisible="False" IsRunning="False"
                               Color="#FF9900" HorizontalOptions="Center"/>

            <!-- Boutons -->
            <Button Text="💾 Enregistrer comme brouillon"
                    Clicked="OnSaveDraftClicked"
                    BackgroundColor="#FF9900"
                    TextColor="White"
                    CornerRadius="12"
                    HeightRequest="52"
                    FontAttributes="Bold"
                    FontSize="15"/>

            <Button Text="Annuler"
                    Clicked="OnCancelClicked"
                    BackgroundColor="Transparent"
                    TextColor="#718096"
                    BorderColor="#CBD5E0"
                    BorderWidth="1.5"
                    CornerRadius="12"
                    HeightRequest="46"
                    FontSize="14"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
